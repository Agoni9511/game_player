.tab-shell{position:fixed;z-index:999;left:24rpx;right:24rpx;bottom:calc(18rpx + env(safe-area-inset-bottom));height:112rpx;padding:0 12rpx;border:1rpx solid rgba(50,78,64,.25);border-radius:10rpx 32rpx 10rpx 32rpx;display:flex;align-items:center;background:rgba(255,252,240,.96);box-shadow:0 12rpx 42rpx rgba(40,55,46,.16)}
.tab-item{position:relative;flex:1;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5rpx;color:#849087;font-size:20rpx}.tab-item>image{width:42rpx;height:42rpx;opacity:.42}.tab-item.selected{color:#315c50;font-weight:700}.tab-item.selected>image{opacity:1}.center-item{padding-top:34rpx;color:#315c50}.center-circle{position:absolute;top:-45rpx;width:100rpx;height:92rpx;border:9rpx solid #f7f1df;border-radius:42rpx 42rpx 18rpx 18rpx;display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,#486f61,#274d43);box-shadow:0 10rpx 28rpx rgba(39,77,67,.3)}.center-circle:after{content:'凌';position:absolute;right:-10rpx;top:-9rpx;width:31rpx;height:31rpx;border:2rpx solid #f2ddc8;display:flex;align-items:center;justify-content:center;color:#fff6e8;background:#963d31;font-size:18rpx;transform:rotate(6deg)}.center-circle image{width:54rpx;height:54rpx;filter:brightness(0) invert(1)}
