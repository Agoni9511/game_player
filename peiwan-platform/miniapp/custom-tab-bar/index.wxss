.tab-shell {
  position: fixed;
  z-index: 999;
  left: 30rpx;
  right: 30rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  height: 108rpx;
  padding: 0 10rpx;
  border: 1rpx solid rgba(50, 78, 64, 0.2);
  border-radius: 58rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(180deg, rgba(255, 253, 246, 0.98), rgba(247, 241, 223, 0.97));
  box-shadow:
    0 16rpx 40rpx rgba(40, 55, 46, 0.18),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
}

.tab-shell::before {
  content: '';
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  top: 8rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.95), transparent);
}

.tab-item {
  position: relative;
  z-index: 1;
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  color: #849087;
  font-size: 20rpx;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.48;
}

.tab-item.selected {
  color: #315c50;
  font-weight: 700;
}

.tab-item.selected .tab-icon {
  opacity: 1;
}

.center-item {
  z-index: 2;
}

.center-circle {
  position: absolute;
  top: -44rpx;
  width: 112rpx;
  height: 112rpx;
  border: 8rpx solid #f7f1df;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  color: #fffaf0;
  background: linear-gradient(145deg, #52796b, #274d43);
  box-shadow:
    0 12rpx 28rpx rgba(39, 77, 67, 0.32),
    inset 0 3rpx 4rpx rgba(255, 255, 255, 0.18);
}

.center-circle::before {
  content: '';
  position: absolute;
  left: 19rpx;
  top: 12rpx;
  width: 44rpx;
  height: 18rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  transform: rotate(-18deg);
}

.center-circle::after {
  content: '凌';
  position: absolute;
  right: -8rpx;
  top: -7rpx;
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid #f2ddc8;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff6e8;
  background: #963d31;
  font-size: 17rpx;
  font-weight: 400;
  transform: rotate(7deg);
}

.center-icon {
  width: 48rpx;
  height: 48rpx;
  filter: brightness(0) invert(1);
}

.center-label {
  position: relative;
  font-size: 18rpx;
  line-height: 24rpx;
  font-weight: 700;
}
